<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Check_enrollment_status_and_Course_id</fullName>
    <active>true</active>
    <description>If status is &quot;Enrolled&quot; there should be a valid Course Id</description>
    <errorConditionFormula>AND(ISPICKVAL( Status__c , &quot;Enrolled&quot;), ISBLANK( Course__c ))</errorConditionFormula>
    <errorMessage>Course Details needed for  status &quot;Enrolled&quot;</errorMessage>
</ValidationRule>
