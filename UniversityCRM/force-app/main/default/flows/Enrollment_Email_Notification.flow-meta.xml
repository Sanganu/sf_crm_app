<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>Sends a confirmation email when an Enrollment becomes 'Enrolled' (insert or update). Async — does not block the enrollment commit.</description>
    <interviewLabel>Enrollment Email Notification {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Enrollment Email Notification</label>
    <processType>AutoLaunchedFlow</processType>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <status>Active</status>

    <start>
        <object>Enrollment__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>TEXT({!$Record.Status__c}) = 'Enrolled'</filterFormula>
        <connector><targetReference>Has_Recipient</targetReference></connector>
    </start>

    <decisions>
        <name>Has_Recipient</name>
        <label>Recipient email present?</label>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Student__r.Email__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Send_Enrollment_Email</targetReference></connector>
        </rules>
        <defaultConnector><targetReference>Log_Missing_Email</targetReference></defaultConnector>
    </decisions>

    <actionCalls>
        <name>Send_Enrollment_Email</name>
        <label>Send Enrollment Email</label>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>NewTransaction</flowTransactionModel>
        <faultConnector><targetReference>Log_Email_Failure</targetReference></faultConnector>
        <inputParameters>
            <name>emailTemplateId</name>
            <value><elementReference>$Label.Enrollment_Confirmation_Template_Id</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>emailMessagingId</name>
            <value><elementReference>$Record.Id</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>recipientAddresses</name>
            <value>
                <collectionElements>
                    <elementReference>$Record.Student__r.Email__c</elementReference>
                </collectionElements>
            </value>
        </inputParameters>
        <inputParameters>
            <name>senderType</name>
            <value><stringValue>OrgWideEmailAddress</stringValue></value>
        </inputParameters>
        <inputParameters>
            <name>senderAddress</name>
            <value><stringValue>registrar@your-university.edu</stringValue></value>
        </inputParameters>
    </actionCalls>

    <recordCreates>
        <name>Log_Email_Failure</name>
        <label>Log email failure</label>
        <object>Integration_Log__c</object>
        <inputAssignments>
            <field>Direction__c</field><value><stringValue>Outbound-Email</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Status_Code__c</field><value><stringValue>FAIL</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Error_Message__c</field><value><elementReference>$Flow.FaultMessage</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>External_Id__c</field><value><elementReference>$Record.Id</elementReference></value>
        </inputAssignments>
    </recordCreates>

    <recordCreates>
        <name>Log_Missing_Email</name>
        <label>Log missing recipient</label>
        <object>Integration_Log__c</object>
        <inputAssignments>
            <field>Direction__c</field><value><stringValue>Outbound-Email</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Status_Code__c</field><value><stringValue>SKIP</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Error_Message__c</field><value><stringValue>Student email is blank</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>External_Id__c</field><value><elementReference>$Record.Id</elementReference></value>
        </inputAssignments>
    </recordCreates>
</Flow>
