<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">
    <configuration-properties file="config.properties"/>
    <!-- HTTP config to get Salesforce token -->
    <http:request-config name="SF_Auth_Config">
        <http:request-connection host="orgfarm-f62760ebb6-dev-ed.develop.my.salesforce.com"
            port="443" protocol="HTTPS"/>
    </http:request-config>
    <!-- HTTP config to call Salesforce REST API -->
    <http:request-config name="SF_API_Config">
        <http:request-connection host="orgfarm-f62760ebb6-dev-ed.develop.my.salesforce.com"
            port="443" protocol="HTTPS"/>
    </http:request-config>
    <flow name="work_flow_Stu_Enro_CourFlow">
        <!-- STEP 1: Receive request from Postman/Banner -->
        <http:listener
            config-ref="HTTP_Listener_Config"
            path="/upsert-student"
            doc:name="Listener"/>

        <set-variable 
            variableName="studentPayload" 
            value="#[payload]" 
            mimeType="application/json" 
            doc:name="Store Original Payload"/>
        <logger level="INFO"
            message="#['Received payload: ' ++ write(payload, 'application/json')]"
            doc:name="Log Request"/>
        <!-- STEP 3: Get Salesforce access token using client credentials -->
        <http:request method="POST"
            config-ref="SF_Auth_Config"
            path="/services/oauth2/token"
            doc:name="Get SF Token">
            <http:body>
                <![CDATA[grant_type=client_credentials&client_id=${sf.ConsumerKey}&client_secret=${sf.ConsumerSecret}]]>
            </http:body>
            <http:headers>
                <![CDATA[#[{"Content-Type": "application/x-www-form-urlencoded"}]]]>
            </http:headers>
        </http:request>
        <!-- STEP 4: Store access token (payload is now token response) -->
        <set-variable 
            variableName="accessToken"
            value="#[payload.access_token]"
            doc:name="Store Access Token"/>
        <!-- STEP 5: Transform student JSON to Salesforce field names -->
        <ee:transform doc:name="Transform to SF Fields">
            <ee:message>
                <ee:set-payload>
                    <![CDATA[%dw 2.0
output application/json
var students = vars.studentPayload
---
students map (student) -> {
    Name__c:                     student.firstName,
    Last_Name__c:                student.lastName,
    Email__c:                    student.email,
    Phone__c:                    student.phone,
    Date_of_Birth__c:            student.dateOfBirth,
    Department__c:               student.department,
    Status__c:                   student.status default "Active",
    GPA__c:                      student.gpa,
    Total_credits__c:            student.totalCredits default 0,
    Program_Start_Date__c:       student.programStartDate,
    Expected_Graduation_Date__c: student.expectedGraduationDate
}]]>
                </ee:set-payload>
            </ee:message>
        </ee:transform>
        <!-- STEP 6: Loop through each student and upsert to Salesforce -->
        <foreach doc:name="For Each Student">
            <!-- Get External ID from ORIGINAL payload using counter -->
            <set-variable
                variableName="externalId"
                value="#[%dw 2.0
output application/java
---
vars.studentPayload[vars.counter - 1].studentExternalId]"
                doc:name="Get External ID"/>
            <logger level="INFO"
        message="#['Current item in foreach: ' ++ write(payload, 'application/json')]"
        doc:name="Log Foreach Item"/>
            <!-- <logger level="INFO"
    message="#['Counter: ' ++ (vars.counter as String)]"
    doc:name="Log Before Upsert"/> -->
    <logger level="INFO"
    message="#['SF Response: ' ++ write(payload, 'application/json')]"
    doc:name="Log SF Response"/>
            <!-- PATCH = Upsert (create or update) by External ID -->
            <http:request method="PATCH"
                config-ref="SF_API_Config"
                path="#['/services/data/v60.0/sobjects/Student__c/Student_External_Id__c/' ++ vars.externalId]"
                doc:name="Upsert Student to SF">
                <http:body>#[payload]</http:body>
                <http:headers>
                    <![CDATA[#[{
                    "Authorization": "Bearer " ++ vars.accessToken,
                    "Content-Type": "application/json"
                }]]]>
                </http:headers>
                <http:response-validator>
                    <http:success-status-code-validator values="200,201,204,400,404"/>
                </http:response-validator>
            </http:request>
            <logger level="INFO"
                message="#['SF Response for ' ++  ': ' ++ write(payload, 'application/json')]"
                doc:name="Log SF Response"/>
        </foreach>
        <logger level="INFO"
            message="#['All students upserted successfully']"
            doc:name="Log Complete"/>
        <!-- STEP 7: Return success response to caller -->
        <ee:transform doc:name="Build Success Response">
            <ee:message>
                <ee:set-payload>
                    <![CDATA[%dw 2.0
output application/json
---
{
    status: "success",
    message: "Students upserted successfully"
}]]>
                </ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
</mule>